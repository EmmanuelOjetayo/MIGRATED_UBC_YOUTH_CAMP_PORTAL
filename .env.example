# ============================================================
# CAMP-Backend (UBC Youth Camp) — environment template
# Copy to `.env` and fill in real values.
# This backend is INDEPENDENT of the GLS backend (`Backend/`).
# ============================================================

# ── Server ─────────────────────────────────────────────────
PORT=5050
NODE_ENV=development

# ── DNS (optional) ──────────────────────────────────────────
# Only set this if the default resolver cannot answer Atlas SRV
# lookups. Comma-separated list of DNS server IPs.
# CAMP_DNS_SERVERS=8.8.8.8,1.1.1.1

# ── MongoDB ────────────────────────────────────────────────
# CAMP reuses the SAME MongoDB cluster/infrastructure as GLS.
# CAMP data lives in its own `yc*` collections and never in GLS collections.
CAMP_MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=UBCYC

# ── CAMP JWT ───────────────────────────────────────────────
# MUST be different from the GLS backend JWT secret.
CAMP_JWT_SECRET=replace-with-a-long-random-camp-only-secret

# ── CAMP business rules ────────────────────────────────────
CAMP_TARGET_FEE=5000

# ── Offline admin PWA sync (OPT-IN, default OFF) ────────────
# Enables POST /api/admin/sync/push and /api/ycadmin/sync/push, the
# idempotent batch-upload endpoint used by the offline-admin PWA.
# Leave unset/false in production unless the PWA is deployed and in
# use. When off, the PWA still works: it uploads pending operations
# through the existing /api/admin/meal-scan and /souvenir-scan routes.
ENABLE_OFFLINE_SYNC=false

# ── CAMP Flutterwave account (CAMP-specific ONLY) ──────────
# These must never be placed in the GLS backend `Backend/.env`.
CAMP_FLW_PUBLIC_KEY=
CAMP_FLW_SECRET_KEY=
CAMP_FLW_SECRET_HASH=

# ── CORS ───────────────────────────────────────────────────
# Origin of the CAMP frontend (`CAMP/`), not the GLS frontend.
CAMP_CLIENT_URL=http://localhost:5173
# Extra allowed origins (comma-separated) for staging/production.
CAMP_ALLOWED_ORIGINS=

# ── AI agent usage limit ───────────────────────────────────
# Logged-in camper messages per day (admins are unlimited).
CAMP_AI_DAILY_LIMIT=15
# Guest (not logged in) messages per day.
CAMP_AI_GUEST_LIMIT=10

# ── CAMP transactional email (Brevo) ───────────────────────
CAMP_EMAIL_USER=
CAMP_EMAIL_PASS=
CAMP_EMAIL_SENDER_NAME=UBC Youth Camp
CAMP_FRONTEND_URL=http://localhost:5173

# ── Appwrite (LEGACY — read-only, migration only) ──────────
# Used exclusively by `npm run migrate:camp` to read legacy CAMP
# data. The CAMP runtime application does NOT depend on Appwrite.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_CAMPERS_COLLECTION=campers
APPWRITE_PAYMENTS_COLLECTION=payments
APPWRITE_MEALLOGS_COLLECTION=meallogs
APPWRITE_SOUVENIRS_COLLECTION=souvenirs
APPWRITE_API_KEY=